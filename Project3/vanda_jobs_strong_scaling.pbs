#!/bin/bash
# ==============================================================================
# Strong-scaling sweep for row decomposition + nonblocking MPI, N=8192.
# Reuses completed 1- and 4-rank results, reruns 16, 32, 64, 128, and 256.
# ============================================================================== 

#PBS -N heat_strong_scaling
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=32gb
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"
JOB_RESULTS_DIR="results/strong_scaling"
JOB_BIN_DIR="bin/strong_scaling"
rm -rf -- "$JOB_BIN_DIR"
mkdir -p "$JOB_RESULTS_DIR/logs" "$JOB_BIN_DIR"
export RESULTS_DIR="$JOB_RESULTS_DIR" BIN_DIR="$JOB_BIN_DIR"
export SCALING_N="${SCALING_N:-8192}"
export SCALING_STEPS="${SCALING_STEPS:-1000}"
export SCALING_RUNS="${SCALING_RUNS:-5}"
export SCALING_PROCS="${SCALING_PROCS:-16 32 64 128 256}"
export SCALING_PRIOR_CSV="$JOB_RESULTS_DIR/all_strong_scaling_results.csv"

# Keep the completed P=1 and P=4 results; replace only the rank counts rerun here.
read -r -a RERUN_PROCS <<< "$SCALING_PROCS"
for p in "${RERUN_PROCS[@]}"; do
  rm -f -- "$JOB_RESULTS_DIR"/logs/N${SCALING_N}_P${p}_run*.log
  rm -f -- "$JOB_RESULTS_DIR/N${SCALING_N}_P${p}_summary.txt"
done

if command -v module >/dev/null 2>&1; then
  module load gcc 2>/dev/null || true
  module load openmpi 2>/dev/null || module load mpi 2>/dev/null || true
fi

if ! command -v mpicxx >/dev/null 2>&1 || ! command -v mpirun >/dev/null 2>&1; then
  echo "ERROR: mpicxx and mpirun must be available. Load Vanda's compiler/MPI modules."
  exit 1
fi

export OMPI_MCA_mpi_yield_when_idle=1
export PRTE_MCA_mpi_yield_when_idle=1

echo "Strong-scaling job started on: $(hostname) at $(date)"
echo "PBS job ID: ${PBS_JOBID:-N/A}"
echo "Working directory: $(pwd)"
echo "Allocated slots: $(wc -l < "$PBS_NODEFILE")"
echo "Grid: N=$SCALING_N steps=$SCALING_STEPS; rank counts: $SCALING_PROCS; repetitions=$SCALING_RUNS"

chmod +x ./run_strong_scaling.sh
./run_strong_scaling.sh

echo "Strong-scaling job finished at: $(date)"
echo "Results: $(pwd)/$JOB_RESULTS_DIR/"
