#!/bin/bash
# ==============================================================================
# PBS Pro Batch Job Script for NUS Atlas HPC Cluster (atlas8 / atlas9)
# ==============================================================================
# Direct job to the active 'parallel' queue:
#PBS -q parallel
#
# Job Name:
#PBS -N heat_implicit_sweep
#
# Resource Request: 4 compute nodes with 64 CPUs, 64 MPI slots, and 32 GB
# RAM per node (256 MPI slots total):
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=32gb
#
# Request maximum wallclock run time (2 hours):
#PBS -l walltime=02:00:00
#
# Join standard output and standard error into a single log file:
#PBS -j oe
# PBS creates a unique heat_implicit_sweep.o<job-number> file outside results/.

# Change to the directory from which the job was submitted:
cd "$PBS_O_WORKDIR"

# Keep this legacy job's outputs isolated from other experiments.
JOB_RESULTS_DIR="results/atlas_legacy"
JOB_BIN_DIR="bin/atlas_legacy"
rm -rf -- "$JOB_RESULTS_DIR" "$JOB_BIN_DIR"
mkdir -p "$JOB_RESULTS_DIR" "$JOB_BIN_DIR"
export RESULTS_DIR="$JOB_RESULTS_DIR" BIN_DIR="$JOB_BIN_DIR"

# Load required cluster modules (Atlas environment):
module load gcc/7.3.0 openmpi/4.1.2 2>/dev/null || module load openmpi/4.1.2 2>/dev/null || true

# Fix Atlas CentOS 7 GCC runtime library dependencies (MPFR, GMP, MPC):
export LD_LIBRARY_PATH="/app1/centos6.3/gnu/mpfr-2.4.2/lib:/app1/centos6.3/gnu/gmp-4.3.2/lib:/app1/centos6.3/gnu/mpc-0.8.1/lib:${LD_LIBRARY_PATH:-}"

# Prevent OpenMPI spin-lock convoy on 32-core allocation:
export OMPI_MCA_mpi_yield_when_idle=1
export PRTE_MCA_mpi_yield_when_idle=1

# Enable benchmarking of the 2 new contiguous buffer packing implementations:
export RUN_CONTIGUOUS=true

echo "=========================================================="
echo " Job started on : $(hostname) at $(date)"
echo " Working Dir    : $(pwd)"
echo " PBS Job ID     : ${PBS_JOBID:-N/A}"
echo " Alloc Nodefile : ${PBS_NODEFILE:-N/A}"
if [ -n "${PBS_NODEFILE:-}" ]; then
  echo " Allocated Cores: $(wc -l < "$PBS_NODEFILE")"
fi
echo "=========================================================="

# Make sure all helper scripts are executable:
chmod +x *.sh

# Execute the complete 5-configuration sweep:
# Syntax: ./sweep_experiments.sh [N] [STEPS] [REPETITIONS]
# Default: N=3000, STEPS=1000, 5 runs each for all 5 configurations
./sweep_experiments.sh 3000 1000 5

echo "=========================================================="
echo " Job finished at $(date)"
echo " Results available in: $(pwd)/$JOB_RESULTS_DIR/"
echo " All Results Table   : $(pwd)/$JOB_RESULTS_DIR/all_results.csv"
echo "=========================================================="
