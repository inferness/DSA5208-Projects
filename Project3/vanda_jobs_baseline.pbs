#!/bin/bash
# ==============================================================================
# PBS Pro alternating serial / one-rank MPI baseline diagnostic for Vanda
# ==============================================================================
# Compares the serial implementation with one MPI rank using one CPU core.

#PBS -N heat_baseline_compare
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=32gb
#PBS -l walltime=01:30:00
#PBS -j oe
# Let PBS create a unique job output file (heat_baseline_compare.o<job-number>).

set -euo pipefail

cd "$PBS_O_WORKDIR"
JOB_RESULTS_DIR="results/baseline_troubleshooting"
JOB_BIN_DIR="bin/baseline_troubleshooting"
rm -rf -- "$JOB_RESULTS_DIR" "$JOB_BIN_DIR"
mkdir -p "$JOB_RESULTS_DIR/vectorization" "$JOB_RESULTS_DIR/disassembly" "$JOB_BIN_DIR"
export RESULTS_DIR="$JOB_RESULTS_DIR" BIN_DIR="$JOB_BIN_DIR"

if command -v module >/dev/null 2>&1; then
  module load gcc 2>/dev/null || true
  module load openmpi 2>/dev/null || module load mpi 2>/dev/null || true
fi

if ! command -v mpicxx >/dev/null 2>&1; then
  echo "ERROR: mpicxx is not available. Load Vanda's compiler/MPI modules first."
  exit 1
fi

export OMPI_MCA_mpi_yield_when_idle=1
export PRTE_MCA_mpi_yield_when_idle=1

chmod +x ./run_benchmark.sh

{
  echo "Job started on: $(hostname) at $(date)"
  echo "PBS job ID: ${PBS_JOBID:-N/A}"
  echo "Working directory: $(pwd)"
  echo "Host/kernel:"
  uname -a
  echo "CPU details:"
  lscpu 2>&1 || true
  echo "Loaded modules:"
  module list 2>&1 || true
  echo "MPI wrapper command:"
  mpicxx --showme:command 2>/dev/null || mpicxx -show
  echo "Compiler version (via MPI wrapper):"
  mpicxx --version
  echo "MPI launcher version:"
  mpirun --version
  echo "Open MPI library version:"
  ompi_info --version 2>&1 || true
  echo "MPI compile flags:"
  mpicxx --showme:compile 2>&1 || true
  echo "MPI link flags:"
  mpicxx --showme:link 2>&1 || true
  echo "Serial variants: original per-cell max and optimized per-row max; optimized serial is the efficiency baseline"
} | tee "$RESULTS_DIR/toolchain.txt"

export ENABLE_EXTERNAL_WALL_TIME=true
export ENABLE_PERF_STAT=false
if command -v perf >/dev/null 2>&1 && \
   perf stat -x, -o /dev/null \
     -e task-clock,cycles,instructions,cache-references,cache-misses,branches,branch-misses \
     true >/dev/null 2>&1; then
  export ENABLE_PERF_STAT=true
  echo "Hardware counters enabled; results will be saved in $RESULTS_DIR/logs/*.perf.csv" | tee -a "$RESULTS_DIR/toolchain.txt"
else
  echo "Hardware counters unavailable or restricted; external wall timing will still be recorded." | tee -a "$RESULTS_DIR/toolchain.txt"
fi

RUNS="${BASELINE_PAIRS:-5}"
for ((pair = 1; pair <= RUNS; pair++)); do
  echo "=========================================================="
  echo "Paired benchmark $pair / $RUNS at $(date)"

  export CXXFLAGS="-O3 -std=c++17 -fopt-info-vec-all=$RESULTS_DIR/vectorization/serial_unoptimized.txt"
  export EXPERIMENT_ID="heat_serial_unoptimized_pair${pair}"
  ./run_benchmark.sh heat_serial_implicit_unoptimized.cpp 1 1 1 3000 1000
  if [ "$pair" -eq 1 ]; then
    if command -v objdump >/dev/null 2>&1; then
      objdump -d -C "$BIN_DIR/heat_serial_implicit_unoptimized" > "$RESULTS_DIR/disassembly/heat_serial_implicit_unoptimized.asm"
    else
      echo "objdump unavailable; unoptimized serial disassembly not captured." | tee -a "$RESULTS_DIR/toolchain.txt"
    fi
  fi

  export CXXFLAGS="-O3 -std=c++17 -fopt-info-vec-all=$RESULTS_DIR/vectorization/serial_optimized.txt"
  export EXPERIMENT_ID="heat_serial_optimized_pair${pair}"
  ./run_benchmark.sh heat_serial_implicit_optimized.cpp 1 1 1 3000 1000
  if [ "$pair" -eq 1 ]; then
    if command -v objdump >/dev/null 2>&1; then
      objdump -d -C "$BIN_DIR/heat_serial_implicit_optimized" > "$RESULTS_DIR/disassembly/heat_serial_implicit_optimized.asm"
    else
      echo "objdump unavailable; optimized serial disassembly not captured." | tee -a "$RESULTS_DIR/toolchain.txt"
    fi
  fi

  export CXXFLAGS="-O3 -std=c++17 -fopt-info-vec-all=$RESULTS_DIR/vectorization/mpi_implicit_p1.txt"
  export EXPERIMENT_ID="heat_mpi_implicit_p1_optimized_baseline_pair${pair}"
  ./run_benchmark.sh heat_mpi_implicit.cpp 1 1 1 3000 1000
  if [ "$pair" -eq 1 ]; then
    if command -v objdump >/dev/null 2>&1; then
      objdump -d -C "$BIN_DIR/heat_mpi_implicit" > "$RESULTS_DIR/disassembly/heat_mpi_implicit.asm"
    else
      echo "objdump unavailable; MPI disassembly not captured." | tee -a "$RESULTS_DIR/toolchain.txt"
    fi
  fi
done

echo "Job finished at: $(date)"
echo "Results: $(pwd)/$RESULTS_DIR/"
