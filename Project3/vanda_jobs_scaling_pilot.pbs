#!/bin/bash
# ==============================================================================
# Single-run strong-scaling pilot: N=8192, one MPI rank
# ==============================================================================

#PBS -N heat_scale_pilot
#PBS -l select=1:ncpus=16:mpiprocs=1:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"
JOB_RESULTS_DIR="results/scaling_pilot"
JOB_BIN_DIR="bin/scaling_pilot"
rm -rf -- "$JOB_RESULTS_DIR" "$JOB_BIN_DIR"
mkdir -p "$JOB_RESULTS_DIR" "$JOB_BIN_DIR"
export SCALING_PILOT_DIR="$JOB_RESULTS_DIR" BIN_DIR="$JOB_BIN_DIR"

if command -v module >/dev/null 2>&1; then
  module load gcc 2>/dev/null || true
  module load openmpi 2>/dev/null || module load mpi 2>/dev/null || true
fi

if ! command -v mpicxx >/dev/null 2>&1 || ! command -v mpirun >/dev/null 2>&1; then
  echo "ERROR: mpicxx and mpirun must be available. Load Vanda's compiler/MPI modules."
  exit 1
fi

export OMPI_MCA_mpi_yield_when_idle=1
export PRTE_MCA_mpi_yield_when_idle=1

echo "Scaling pilot started on: $(hostname) at $(date)"
echo "PBS job ID: ${PBS_JOBID:-N/A}"
echo "Working directory: $(pwd)"
echo "Allocated slots: $(wc -l < "$PBS_NODEFILE")"

chmod +x ./run_scaling_pilot.sh
./run_scaling_pilot.sh

echo "Scaling pilot finished at: $(date)"
echo "Results: $(pwd)/$JOB_RESULTS_DIR/"
